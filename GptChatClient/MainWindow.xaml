<Window x:Class="GptChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPT Chat Client" Height="640" Width="920"
        Background="#0F172A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1220" CornerRadius="12" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Conversation" Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="12" Background="#111827" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Role}" Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#F8FAFC" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#0B1220" CornerRadius="12" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Height="48" Background="#111827" Foreground="#F8FAFC" BorderThickness="0" Padding="12" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Send" Width="120" Height="48" Margin="12,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0" Command="{Binding SendCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
